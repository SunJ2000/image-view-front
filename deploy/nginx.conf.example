# Install as /etc/nginx/conf.d/image-view.conf.
# Upload the CONTENTS of dist/ to /opt/image-view-front/.
# Expected file: /opt/image-view-front/index.html.
server {
    listen 80;
    server_name sunj2000.com 106.14.136.223;

    location /api/ {
        # No trailing slash: preserve the backend's /api/ prefix.
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location = /image-view {
        return 301 /image-view/$is_args$args;
    }

    location ^~ /image-view/assets/ {
        alias /opt/image-view-front/assets/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /image-view/favicon.svg {
        alias /opt/image-view-front/favicon.svg;
    }

    location = /image-view/index.html {
        alias /opt/image-view-front/index.html;
        add_header Cache-Control "no-cache" always;
    }

    location /image-view/ {
        alias /opt/image-view-front/;
        index index.html;
        try_files $uri $uri/ /image-view/index.html;
        add_header Cache-Control "no-cache" always;
    }

    location / {
        return 404;
    }
}
