# Install as /etc/nginx/conf.d/image-view.conf.
# Replaces the supplied HTTP-only image-view.conf; do not add a second server block.
# Frontend archive must extract to /var/www/image-view-front/dist/index.html.
server {
    listen 80;
    server_name sunj2000.com 106.14.136.223;
    root /var/www/image-view-front/dist;
    index index.html;

    location /api/ {
        # No trailing slash: preserve the backend's /api/ prefix.
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location ^~ /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
    }
}
